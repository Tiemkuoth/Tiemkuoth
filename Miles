  <script>
    /* ===== PRELOADER ===== */
    window.addEventListener('load', () => {
      setTimeout(() => {
        document.getElementById('preloader').classList.add('hidden');
      }, 1600);
    });

    /* ===== HEADER SCROLL ===== */
    const header = document.getElementById('header');
    window.addEventListener('scroll', () => {
      header.classList.toggle('scrolled', window.scrollY > 60);
      document.getElementById('scroll-top').classList.toggle('visible', window.scrollY > 400);
    });

    /* ===== NAV GLIDE INDICATOR ===== */
    const glide = document.getElementById('nav-glide');
    const navLinks = document.querySelectorAll('.nav-pill .nav-link:not(.nav-cta)');
    function moveGlide(el) {
      if (!el || el.classList.contains('nav-cta')) { glide.style.opacity = '0'; return; }
      const pill = el.closest('.nav-pill');
      const pillRect = pill.getBoundingClientRect();
      const elRect = el.getBoundingClientRect();
      glide.style.left = (elRect.left - pillRect.left) + 'px';
      glide.style.width = elRect.width + 'px';
      glide.style.opacity = '1';
    }

    navLinks.forEach(a => {
      a.addEventListener('mouseenter', () => moveGlide(a));
    });
    document.querySelector('.nav-pill').addEventListener('mouseleave', () => {
      const active = document.querySelector('.nav-pill .nav-link.active');
      moveGlide(active);
    });

    function setActiveLink(id) {
      document.querySelectorAll('.nav-link, .drawer-link').forEach(a => a.classList.remove('active'));
      const pill = document.querySelector(`.nav-pill a[href="#${id}"]`);
      const drawer = document.querySelector(`.drawer-link[href="#${id}"]`);
      if (pill) { pill.classList.add('active'); moveGlide(pill.classList.contains('nav-cta') ? null : pill); }
      if (drawer) drawer.classList.add('active');
    }

    // Init glide on active
    window.addEventListener('load', () => {
      const active = document.querySelector('.nav-pill .nav-link.active');
      if (active) setTimeout(() => moveGlide(active), 200);
    });
    window.addEventListener('resize', () => {
      const active = document.querySelector('.nav-pill .nav-link.active');
      if (active) moveGlide(active);
    });

    /* ===== ACTIVE NAV FROM SCROLL ===== */
    const sections = document.querySelectorAll('section[id]');
    const sectionObs = new IntersectionObserver((entries) => {
      entries.forEach(e => { if (e.isIntersecting) setActiveLink(e.target.id); });
    }, { threshold: 0.35 });
    sections.forEach(s => sectionObs.observe(s));

    /* ===== MOBILE DRAWER ===== */
    const menuBtn = document.getElementById('menu');
    const drawer = document.getElementById('mobile-drawer');
    const drawerBackdrop = document.getElementById('drawer-backdrop');
    function openDrawer() {
      drawer.classList.add('open');
      menuBtn.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeDrawer() {
      drawer.classList.remove('open');
      menuBtn.classList.remove('open');
      document.body.style.overflow = '';
    }
    menuBtn.addEventListener('click', () => drawer.classList.contains('open') ? closeDrawer() : openDrawer());
    drawerBackdrop.addEventListener('click', closeDrawer);
    document.querySelectorAll('.drawer-link').forEach(a => a.addEventListener('click', closeDrawer));
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });

    /* ===== SCROLL REVEAL ===== */
    const revealObs = new IntersectionObserver((entries) => {
      entries.forEach(e => {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          // Animate skill bars
          e.target.querySelectorAll('.skill-bar-fill[data-w]').forEach(bar => {
            setTimeout(() => { bar.style.width = bar.dataset.w; }, 100);
          });
          revealObs.unobserve(e.target);
        }
      });
    }, { threshold: 0.15 });
    document.querySelectorAll('.reveal').forEach(el => revealObs.observe(el));

    /* ===== TYPING EFFECT ===== */
    const words = ['beautiful interfaces.', 'clean, fast code.', 'memorable experiences.', 'the web, better.'];
    let wi = 0, ci = 0, deleting = false;
    const typedEl = document.getElementById('typed-text');
    function type() {
      const word = words[wi];
      if (!deleting) {
        typedEl.textContent = word.slice(0, ++ci);
        if (ci === word.length) { deleting = true; setTimeout(type, 1800); return; }
      } else {
        typedEl.textContent = word.slice(0, --ci);
        if (ci === 0) { deleting = false; wi = (wi + 1) % words.length; }
      }
      setTimeout(type, deleting ? 55 : 85);
    }
    setTimeout(type, 1800);

    /* ===== WISDOM ROTATOR ===== */
    const wisdoms = [
      { q: '"When the webs of the spider join, they can trap a lion."', s: '— Gamo Wisdom on Unity' },
      { q: '"If one part of nature is disturbed, the whole community is disturbed."', s: '— On Environmental Balance' },
      { q: '"Peace is not just the absence of war; it is the presence of respect."', s: '— The Spirit of Gamo Woga' },
    ];
    let wIdx = 0;
    setInterval(() => {
      wIdx = (wIdx + 1) % wisdoms.length;
      const t = document.getElementById('wisdom-text');
      const s = document.getElementById('wisdom-src');
      t.style.opacity = 0; s.style.opacity = 0;
      setTimeout(() => {
        t.textContent = wisdoms[wIdx].q;
        s.textContent = wisdoms[wIdx].s;
        t.style.transition = 'opacity .5s'; s.style.transition = 'opacity .5s';
        t.style.opacity = 1; s.style.opacity = 1;
      }, 500);
    }, 4500);

    /* ===== HOBBY MODAL ===== */
    const modal = document.getElementById('hobby-modal');
    const modalImg = document.getElementById('modal-img');
    const modalTitle = document.getElementById('modal-title');
    const modalDesc = document.getElementById('modal-desc');
    document.querySelectorAll('.hobby-card').forEach(card => {
      card.addEventListener('click', () => {
        modalTitle.textContent = card.dataset.title || '';
        modalDesc.textContent = card.dataset.desc || '';
        const src = card.querySelector('img')?.src || '';
        modalImg.src = src;
        modalImg.style.display = 'block';
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
      });
    });
    document.getElementById('modal-close').addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    function closeModal() {
      modal.classList.remove('open');
      document.body.style.overflow = '';
    }
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
  </script>
  <!-- External scripts -->
  <script src="./Assets/js/script.js" defer></script>
</body>

