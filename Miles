<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Tiemkuoth – Web Developer Portfolio | HTML, CSS, JavaScript">
  <meta name="theme-color" content="#e8a838">
  <meta property="og:title" content="Tiemkuoth | Web Developer">
  <meta property="og:description"
    content="Web Developer portfolio — HTML, CSS, JavaScript. Based in Arba Minch, Ethiopia.">
  <meta property="og:type" content="website">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Outfit:wght@300;400;500;600&display=swap"
    rel="stylesheet">
  <title>Tiemkuoth | Web Developer</title>
  <!-- External stylesheet -->
  <link rel="stylesheet" href="./Assets/css/style.css">
  <style>
    /* ===== DESIGN TOKENS ===== */
    :root {
      /* Base palette */
      --bg: #090908;
      --bg2: #111110;
      --bg3: #191917;
      --surface: #1e1d1b;
      --border: rgba(232, 168, 56, 0.12);
      --gold: #e8a838;
      --gold-dim: #c28820;
      --terra: #c2652a;
      --sage: #5a8c6e;
      --cream: #f0ede4;
      --text: #ddd9ce;
      --text-dim: #7a7568;
      --text-mute: #3d3b36;
      --radius: 12px;
      --radius-lg: 20px;
      --section-pad: clamp(5rem, 10vw, 9rem);

      /* Section accent colours */
      --about-accent: #38bdf8;
      /* sky blue */
      --skills-accent: #a78bfa;
      /* violet */
      --edu-accent: #fb923c;
      /* amber-orange */
      --work-accent: #34d399;
      /* emerald */
      --hobbies-accent: #86efac;
      /* sage-green */
      --contact-accent: #f87171;
      /* rose */
    }

    /* ===== RESET & BASE ===== */
    *,
    *::before,
    *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      font-family: 'Outfit', sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.7;
      overflow-x: hidden;
    }

    img {
      max-width: 100%;
      height: auto;
      display: block;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    ul {
      list-style: none;
    }

    /* ===== TYPOGRAPHY ===== */
    h1,
    h2,
    h3,
    h4 {
      line-height: 1.15;
    }

    /* ===== PRELOADER ===== */
    #preloader {
      position: fixed;
      inset: 0;
      z-index: 9999;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1rem;
      transition: opacity 0.6s ease, visibility 0.6s ease;
    }

    #preloader.hidden {
      opacity: 0;
      visibility: hidden;
    }

    .preloader-logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 600;
      color: var(--gold);
      letter-spacing: .1em;
    }

    .preloader-bar {
      width: 120px;
      height: 2px;
      background: var(--text-mute);
      border-radius: 2px;
      overflow: hidden;
    }

    .preloader-fill {
      height: 100%;
      width: 0%;
      background: var(--gold);
      animation: preload 1.4s ease forwards;
    }

    @keyframes preload {
      to {
        width: 100%;
      }
    }

    /* ===== NOISE OVERLAY ===== */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      z-index: 0;
      pointer-events: none;
      opacity: .03;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    }

    /* ===== SCROLLBAR ===== */
    ::-webkit-scrollbar {
      width: 4px;
    }

    ::-webkit-scrollbar-track {
      background: var(--bg);
    }

    ::-webkit-scrollbar-thumb {
      background: var(--gold-dim);
      border-radius: 4px;
    }

    /* ===== SECTION REVEAL ===== */
    .reveal {
      opacity: 0;
      transform: translateY(30px);
      transition: opacity .7s ease, transform .7s ease;
    }

    .reveal.visible {
      opacity: 1;
      transform: none;
    }

    /* ===== SECTION HEADING ===== */
    .section-label {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      font-size: .75rem;
      font-weight: 500;
      letter-spacing: .18em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
    }

    .section-label::before {
      content: '';
      width: 28px;
      height: 1px;
      background: var(--gold);
    }

    .section-title {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2.2rem, 5vw, 3.5rem);
      font-weight: 600;
      color: var(--cream);
    }

    .section-title span {
      color: var(--gold);
      font-style: italic;
    }

    /* ===== HEADER ===== */
    header {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      z-index: 1000;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem clamp(1.5rem, 5vw, 4rem);
      transition: padding .4s ease;
    }

    /* Logo */
    .logo {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 700;
      color: var(--cream);
      letter-spacing: .03em;
      display: flex;
      align-items: center;
      gap: .35rem;
      position: relative;
      z-index: 1001;
    }

    .logo-bracket {
      color: var(--gold);
      font-style: normal;
      font-weight: 300;
      font-size: 1.8rem;
      line-height: 1;
      transition: color .3s;
    }

    .logo:hover .logo-bracket {
      color: var(--terra);
    }

    .logo-name {
      letter-spacing: .06em;
    }

    .logo-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--gold);
      align-self: flex-end;
      margin-bottom: .35rem;
      animation: dotPulse 2.5s ease-in-out infinite;
    }

    @keyframes dotPulse {

      0%,
      100% {
        transform: scale(1);
        opacity: 1;
      }

      50% {
        transform: scale(1.6);
        opacity: .6;
      }
    }

    /* Pill navbar */
    .navbar {
      position: relative;
    }

    .nav-pill {
      display: flex;
      align-items: center;
      background: rgba(14, 13, 12, .7);
      border: 1px solid rgba(232, 168, 56, .18);
      border-radius: 50px;
      padding: .35rem .5rem;
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      box-shadow:
        0 4px 24px rgba(0, 0, 0, .5),
        0 0 0 1px rgba(232, 168, 56, .06) inset,
        0 1px 0 rgba(255, 255, 255, .04) inset;
      position: relative;
      gap: .1rem;
    }

    /* Gliding highlight */
    .nav-glide {
      position: absolute;
      top: .35rem;
      left: 0;
      height: calc(100% - .7rem);
      background: linear-gradient(135deg, rgba(232, 168, 56, .18), rgba(194, 101, 42, .1));
      border: 1px solid rgba(232, 168, 56, .25);
      border-radius: 40px;
      transition: left .35s cubic-bezier(.4, 0, .2, 1), width .35s cubic-bezier(.4, 0, .2, 1);
      pointer-events: none;
      box-shadow: 0 0 12px rgba(232, 168, 56, .15);
    }

    .navbar a {
      font-size: .76rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-dim);
      padding: .5rem .9rem;
      border-radius: 40px;
      transition: color .25s;
      position: relative;
      z-index: 1;
      white-space: nowrap;
    }

    .navbar a:hover {
      color: var(--cream);
    }

    .navbar a.active {
      color: var(--gold);
    }

    /* Nav CTA button */
    .nav-cta {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-size: .76rem;
      font-weight: 600;
      letter-spacing: .08em;
      text-transform: uppercase;
      background: var(--gold);
      color: var(--bg) !important;
      padding: .5rem 1.1rem !important;
      border-radius: 40px !important;
      transition: background .25s, transform .2s !important;
      margin-left: .3rem;
    }

    .nav-cta:hover {
      background: var(--gold-dim) !important;
      transform: scale(1.04);
      color: var(--bg) !important;
    }

    .nav-cta i {
      font-size: .7rem;
    }

    /* Hamburger */
    #menu {
      display: none;
      cursor: pointer;
      z-index: 1002;
      width: 42px;
      height: 42px;
      border-radius: 10px;
      background: rgba(14, 13, 12, .7);
      border: 1px solid rgba(232, 168, 56, .2);
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 5px;
      backdrop-filter: blur(12px);
      transition: border-color .3s;
    }

    #menu:hover {
      border-color: rgba(232, 168, 56, .5);
    }

    .burger-line {
      width: 20px;
      height: 2px;
      background: var(--cream);
      border-radius: 2px;
      transition: transform .35s ease, opacity .3s, width .3s;
      transform-origin: center;
    }

    #menu.open .burger-line:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }

    #menu.open .burger-line:nth-child(2) {
      opacity: 0;
      width: 12px;
    }

    #menu.open .burger-line:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }

    /* Mobile drawer */
    .mobile-drawer {
      display: none;
      position: fixed;
      inset: 0;
      z-index: 999;
    }

    .drawer-backdrop {
      position: absolute;
      inset: 0;
      background: rgba(0, 0, 0, .6);
      backdrop-filter: blur(6px);
      opacity: 0;
      transition: opacity .4s ease;
    }

    .drawer-panel {
      position: absolute;
      top: 0;
      right: 0;
      width: min(320px, 90vw);
      height: 100%;
      background: var(--bg2);
      border-left: 1px solid rgba(232, 168, 56, .12);
      display: flex;
      flex-direction: column;
      padding: 5rem 2rem 2rem;
      transform: translateX(100%);
      transition: transform .4s cubic-bezier(.4, 0, .2, 1);
      box-shadow: -20px 0 60px rgba(0, 0, 0, .5);
    }

    .mobile-drawer.open {
      display: flex;
    }

    .mobile-drawer.open .drawer-backdrop {
      opacity: 1;
    }

    .mobile-drawer.open .drawer-panel {
      transform: translateX(0);
    }

    .drawer-panel nav ul {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .drawer-panel nav a {
      display: flex;
      align-items: center;
      gap: .9rem;
      font-size: .88rem;
      font-weight: 500;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-dim);
      padding: 1rem 0;
      border-bottom: 1px solid rgba(232, 168, 56, .07);
      transition: color .25s, padding-left .25s;
    }

    .drawer-panel nav a i {
      width: 18px;
      text-align: center;
      color: var(--text-mute);
      font-size: .8rem;
      transition: color .25s;
    }

    .drawer-panel nav a:hover,
    .drawer-panel nav a.active {
      color: var(--gold);
      padding-left: .5rem;
    }

    .drawer-panel nav a:hover i,
    .drawer-panel nav a.active i {
      color: var(--gold);
    }

    .drawer-footer {
      margin-top: auto;
      padding-top: 2rem;
      border-top: 1px solid rgba(232, 168, 56, .1);
    }

    .drawer-socials {
      display: flex;
      gap: .75rem;
      margin-bottom: 1rem;
    }

    .drawer-socials a {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid rgba(232, 168, 56, .15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .85rem;
      color: var(--text-dim);
      transition: all .25s;
    }

    .drawer-socials a:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .drawer-location {
      font-size: .78rem;
      color: var(--text-mute);
      display: flex;
      align-items: center;
      gap: .4rem;
    }

    .drawer-location i {
      color: var(--gold);
    }

    /* ===== HERO ===== */
    /* White background with subtle gradient */
    .home {
      min-height: 100vh;
      display: grid;
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: 0 clamp(1.5rem, 6vw, 6rem);
      gap: 4rem;
      position: relative;
      overflow: hidden;
      background: linear-gradient(135deg, #ffffff 0%, #f8f9fa 100%);
      color: #1a1a1a;
    }

    .home::after {
      content: '';
      position: absolute;
      right: -200px;
      top: 50%;
      transform: translateY(-50%);
      width: 700px;
      height: 700px;
      background: radial-gradient(ellipse at center, rgba(232, 168, 56, .05) 0%, transparent 65%);
      pointer-events: none;
    }

    .home-content {
      z-index: 1;
    }

    .hero-eyebrow {
      font-size: .78rem;
      font-weight: 500;
      letter-spacing: .2em;
      text-transform: uppercase;
      color: var(--gold);
      display: flex;
      align-items: center;
      gap: .75rem;
      margin-bottom: 1.5rem;
    }

    .hero-eyebrow::before {
      content: '';
      width: 36px;
      height: 1px;
      background: var(--gold);
    }

    .home-content h1 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(3.5rem, 7vw, 6rem);
      font-weight: 600;
      line-height: 1.05;
      color: #1a1a1a;
      margin-bottom: .5rem;
    }

    .home-content h1 em {
      font-style: italic;
      color: var(--gold);
    }

    .hero-role {
      font-size: clamp(1rem, 2vw, 1.2rem);
      color: #4a4a4a;
      font-weight: 300;
      letter-spacing: .04em;
      margin-bottom: 1rem;
    }

    .typing-wrap {
      font-size: 1rem;
      color: #4a4a4a;
      margin-bottom: 2.5rem;
    }

    .typing-wrap strong {
      color: var(--gold);
    }

    .typing-cursor {
      display: inline-block;
      width: 2px;
      height: 1em;
      background: var(--gold);
      margin-left: 2px;
      animation: blink .9s step-end infinite;
      vertical-align: middle;
    }

    @keyframes blink {
      50% {
        opacity: 0;
      }
    }

    .hero-btns {
      display: flex;
      gap: 1rem;
      flex-wrap: wrap;
      margin-bottom: 2.5rem;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .8rem 1.8rem;
      background: var(--gold);
      color: var(--bg);
      border-radius: 4px;
      font-size: .88rem;
      font-weight: 600;
      letter-spacing: .04em;
      transition: background .25s, transform .2s;
    }

    .btn-primary:hover {
      background: var(--gold-dim);
      transform: translateY(-2px);
    }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      gap: .5rem;
      padding: .8rem 1.8rem;
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 4px;
      font-size: .88rem;
      font-weight: 400;
      transition: border-color .25s, color .25s, transform .2s;
    }

    .btn-ghost:hover {
      border-color: var(--gold);
      color: var(--gold);
      transform: translateY(-2px);
    }

    .hero-socials {
      display: flex;
      gap: 1.2rem;
      align-items: center;
    }

    .hero-socials a {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-dim);
      font-size: .9rem;
      transition: border-color .25s, color .25s, background .25s;
    }

    .hero-socials a:hover {
      border-color: var(--gold);
      color: var(--gold);
      background: rgba(232, 168, 56, .06);
    }

    /* Hero image — gold→terra gradient border already set, enhance glow */
    .hero-img-col {
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
    }

    .hero-img-frame {
      position: relative;
      width: min(480px, 94%);
    }

    .hero-img-frame::before {
      content: '';
      position: absolute;
      inset: -3px;
      border-radius: var(--radius-lg);
      background: linear-gradient(135deg, var(--gold), transparent 50%, var(--terra) 100%);
      z-index: 0;
    }

    /* Soft gold halo behind the photo */
    .hero-img-col::after {
      content: '';
      position: absolute;
      width: 115%;
      height: 115%;
      border-radius: var(--radius-lg);
      background: radial-gradient(ellipse at center,
          rgba(232, 168, 56, .2) 0%, transparent 65%);
      pointer-events: none;
      z-index: 0;
    }

    .hero-img-frame img,
    .hero-img-frame .img-placeholder {
      position: relative;
      z-index: 1;
      width: 100%;
      aspect-ratio: 3/4;
      object-fit: cover;
      object-position: top center;
      border-radius: calc(var(--radius-lg) - 3px);
      display: block;
    }

    .img-placeholder {
      background: var(--bg3);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: .75rem;
      color: var(--text-mute);
      font-size: .85rem;
      text-align: center;
    }

    .img-placeholder i {
      font-size: 3rem;
      color: var(--text-mute);
    }

    .hero-deco {
      position: absolute;
      top: 10%;
      right: 0;
      width: 120px;
      height: 120px;
      border: 1px solid var(--border);
      border-radius: 50%;
      animation: spin 20s linear infinite;
      pointer-events: none;
    }

    .hero-deco::after {
      content: '';
      position: absolute;
      top: 20%;
      left: 20%;
      right: 20%;
      bottom: 20%;
      border: 1px solid var(--border);
      border-radius: 50%;
    }

    @keyframes spin {
      to {
        transform: rotate(360deg);
      }
    }

    /* ===== ABOUT ===== */
    /* Pure black background */
    .about {
      padding: var(--section-pad) clamp(1.5rem, 6vw, 6rem);
      background: #000000;
      color: var(--text);
    }

    .about-inner {
      display: grid;
      grid-template-columns: 1fr 1.5fr;
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
      max-width: 1200px;
      margin: 0 auto;
    }

    .about-card {
      position: sticky;
      top: 100px;
      background: #1a1a1a;
      border: 1px solid rgba(56, 189, 248, .15);
      border-radius: var(--radius-lg);
      padding: 2rem;
      text-align: center;
      box-shadow: 0 0 40px rgba(56, 189, 248, .06);
    }

    /* Photo ring — sky-blue glow */
    .about-img-wrap img,
    .about-img-wrap .img-placeholder {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      object-fit: cover;
      object-position: top center;
      border: 3px solid var(--about-accent);
      box-shadow: 0 0 32px rgba(56, 189, 248, .28);
    }

    .about-img-wrap {
      position: relative;
      margin-bottom: 1.5rem;
      display: inline-block;
    }

    .about-img-wrap .img-placeholder {
      width: 200px;
      height: 200px;
      border-radius: 50%;
      background: var(--surface);
      align-items: center;
      justify-content: center;
      gap: 0;
    }

    .about-status {
      position: absolute;
      bottom: 8px;
      right: -8px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 20px;
      padding: .3rem .7rem;
      font-size: .72rem;
      font-weight: 500;
      color: var(--sage);
      display: flex;
      align-items: center;
      gap: .3rem;
    }

    .status-pulse {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--sage);
      animation: pulse 1.5s ease-in-out infinite;
    }

    @keyframes pulse {

      0%,
      100% {
        transform: scale(1);
        opacity: 1
      }

      50% {
        transform: scale(1.4);
        opacity: .6
      }
    }

    .about-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      color: var(--cream);
      margin-bottom: .25rem;
    }

    .about-role-tag {
      display: inline-block;
      font-size: .75rem;
      font-weight: 500;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1px solid rgba(232, 168, 56, .3);
      border-radius: 20px;
      padding: .3rem .9rem;
      margin-bottom: 1.25rem;
    }

    .about-chips {
      display: flex;
      flex-direction: column;
      gap: .55rem;
    }

    .about-chips span {
      display: flex;
      align-items: center;
      gap: .6rem;
      font-size: .82rem;
      color: var(--text-dim);
    }

    .about-chips span i {
      color: var(--gold);
      width: 14px;
      text-align: center;
    }

    .about-content {
      padding-top: .5rem;
    }

    .about-content .section-label {
      margin-bottom: .75rem;
    }

    .about-bio {
      font-size: 1.05rem;
      color: var(--text-dim);
      margin-bottom: 1rem;
      line-height: 1.75;
    }

    .about-bio strong {
      color: var(--cream);
    }

    .about-bio em {
      color: var(--gold);
      font-style: normal;
    }

    .stats-row {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
      margin: 2rem 0;
    }

    .stat-item {
      background: var(--bg3);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.25rem 1rem;
      text-align: center;
    }

    .stat-num {
      display: block;
      font-family: 'Cormorant Garamond', serif;
      font-size: 2rem;
      font-weight: 600;
      color: var(--gold);
      line-height: 1;
    }

    .stat-lbl {
      display: block;
      font-size: .72rem;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-top: .3rem;
    }

    .tags-row {
      display: flex;
      flex-wrap: wrap;
      gap: .5rem;
      margin-top: 1.5rem;
    }

    .tag-pill {
      font-size: .78rem;
      font-weight: 500;
      padding: .35rem .9rem;
      border-radius: 20px;
      background: rgba(232, 168, 56, .06);
      border: 1px solid var(--border);
      color: var(--text-dim);
      transition: border-color .2s, color .2s;
    }

    .tag-pill:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    /* ===== SKILLS ===== */
    /* Navy blue background */
    .skills {
      padding: var(--section-pad) clamp(1.5rem, 6vw, 6rem);
      position: relative;
      background: linear-gradient(135deg, #001f3f 0%, #003366 100%);
      color: var(--text);
    }

    .skills::before {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: radial-gradient(ellipse 50% 40% at 50% 100%,
          rgba(167, 139, 250, .03) 0%, transparent 60%);
    }

    .skills-header {
      max-width: 1200px;
      margin: 0 auto 3rem;
    }

    .skills-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 1.25rem;
    }

    .skill-card {
      background: rgba(167, 139, 250, .04);
      border: 1px solid rgba(167, 139, 250, .12);
      border-radius: var(--radius);
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: .6rem;
      transition: border-color .3s, transform .3s, box-shadow .3s;
      position: relative;
      overflow: hidden;
    }

    .skill-card:hover {
      border-color: rgba(167, 139, 250, .4);
      transform: translateY(-4px);
      box-shadow: 0 8px 32px rgba(167, 139, 250, .12);
    }

    .skill-card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 2px;
      background: linear-gradient(90deg, var(--c, var(--skills-accent)), transparent);
      opacity: 0;
      transition: opacity .3s;
    }

    .skill-card:hover::before {
      opacity: 1;
    }

    .skill-icon {
      width: 44px;
      height: 44px;
      border-radius: 10px;
      background: rgba(255, 255, 255, .04);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
      color: var(--c, var(--skills-accent));
      margin-bottom: .25rem;
    }

    .skill-card h3 {
      font-size: .95rem;
      font-weight: 600;
      color: var(--cream);
    }

    .skill-card p {
      font-size: .82rem;
      color: var(--text-dim);
      flex: 1;
    }

    .skill-bar-bg {
      height: 4px;
      background: rgba(255, 255, 255, .06);
      border-radius: 4px;
      overflow: hidden;
      margin-top: auto;
    }

    .skill-bar-fill {
      height: 100%;
      border-radius: 4px;
      background: var(--c, var(--skills-accent));
      width: 0%;
      transition: width 1.4s cubic-bezier(.4, 0, .2, 1);
    }

    /* ===== EDUCATION ===== */
    /* Warm academic beige/cream — scholarly atmosphere */
    .education {
      padding: var(--section-pad) clamp(1.5rem, 6vw, 6rem);
      background: linear-gradient(135deg, #f5f1e8 0%, #e8dcc8 100%);
      color: #2a2a2a;
    }

    .edu-inner {
      max-width: 800px;
      margin: 0 auto;
    }

    .edu-quote-block {
      border-left: 3px solid var(--edu-accent);
      padding: 1rem 1.5rem;
      margin-bottom: 3rem;
      color: #4a4a4a;
      font-style: italic;
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.1rem;
      background: rgba(251, 146, 60, .08);
      border-radius: 0 var(--radius) var(--radius) 0;
    }

    .edu-timeline {
      display: flex;
      flex-direction: column;
      gap: 0;
    }

    .edu-entry {
      display: grid;
      grid-template-columns: 60px 1fr;
      gap: 0 1.5rem;
      position: relative;
    }

    .edu-dot-col {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .edu-dot {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: #ffffff;
      border: 2px solid rgba(251, 146, 60, .4);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .85rem;
      color: #666;
      flex-shrink: 0;
      transition: border-color .3s, color .3s, box-shadow .3s;
      z-index: 1;
    }

    .edu-dot.active {
      border-color: var(--edu-accent);
      color: var(--edu-accent);
      box-shadow: 0 0 16px rgba(251, 146, 60, .3);
    }

    .edu-line {
      flex: 1;
      width: 1px;
      background: rgba(251, 146, 60, .25);
      margin: 4px 0;
      min-height: 32px;
    }

    .edu-card {
      background: rgba(255, 255, 255, .85);
      border: 1px solid rgba(251, 146, 60, .2);
      border-radius: var(--radius);
      padding: 1.5rem;
      margin-bottom: 1.5rem;
      transition: border-color .3s, box-shadow .3s;
    }

    .edu-card:hover {
      border-color: rgba(251, 146, 60, .5);
      box-shadow: 0 4px 24px rgba(251, 146, 60, .15);
    }

    .edu-card.current {
      border-left: 3px solid var(--edu-accent);
      background: rgba(251, 146, 60, .12);
    }

    .edu-card-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 1rem;
      margin-bottom: .75rem;
      flex-wrap: wrap;
    }

    .edu-tag {
      font-size: .68rem;
      font-weight: 600;
      letter-spacing: .1em;
      text-transform: uppercase;
      padding: .25rem .7rem;
      border-radius: 20px;
    }

    .edu-tag.current {
      background: rgba(251, 146, 60, .14);
      color: var(--edu-accent);
    }

    .edu-tag.done {
      background: rgba(90, 140, 110, .12);
      color: var(--sage);
    }

    .edu-card h3 {
      font-size: 1.05rem;
      font-weight: 600;
      color: #1a1a1a;
      margin: .4rem 0 .25rem;
    }

    .edu-school {
      font-size: .85rem;
      color: #555;
      display: flex;
      align-items: center;
      gap: .4rem;
    }

    .edu-school a {
      color: #555;
      transition: color .2s;
    }

    .edu-school a:hover {
      color: var(--edu-accent);
    }

    .edu-year {
      font-size: .78rem;
      color: #777;
      white-space: nowrap;
    }

    .edu-desc {
      font-size: .88rem;
      color: #4a4a4a;
      margin: .75rem 0;
      line-height: 1.65;
    }

    .edu-tags {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
    }

    .edu-tags span {
      font-size: .74rem;
      padding: .25rem .7rem;
      background: rgba(251, 146, 60, .1);
      border: 1px solid rgba(251, 146, 60, .25);
      border-radius: 20px;
      color: #555;
      display: flex;
      align-items: center;
      gap: .35rem;
    }

    .edu-tags span i {
      color: var(--edu-accent);
    }

    /* ===== PROJECTS ===== */
    /* Professional slate gray — tech/work atmosphere */
    .work {
      padding: var(--section-pad) clamp(1.5rem, 6vw, 6rem);
      background: linear-gradient(135deg, #2c3e50 0%, #34495e 100%);
      color: var(--text);
    }

    .work-header {
      max-width: 1200px;
      margin: 0 auto 3rem;
    }

    .work-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
      gap: 1.5rem;
    }

    .project-card {
      background: rgba(52, 211, 153, .03);
      border: 1px solid rgba(52, 211, 153, .1);
      border-radius: var(--radius-lg);
      overflow: hidden;
      transition: border-color .3s, transform .3s, box-shadow .3s;
    }

    .project-card:hover {
      border-color: rgba(52, 211, 153, .35);
      transform: translateY(-6px);
      box-shadow: 0 12px 40px rgba(52, 211, 153, .1);
    }

    .project-thumb {
      aspect-ratio: 16/9;
      overflow: hidden;
      position: relative;
    }

    .project-thumb svg {
      width: 100%;
      height: 100%;
    }

    .project-body {
      padding: 1.5rem;
    }

    .project-tags {
      display: flex;
      flex-wrap: wrap;
      gap: .4rem;
      margin-bottom: 1rem;
    }

    .project-tag {
      font-size: .7rem;
      font-weight: 500;
      letter-spacing: .06em;
      text-transform: uppercase;
      padding: .25rem .65rem;
      border-radius: 20px;
      background: rgba(52, 211, 153, .1);
      color: var(--work-accent);
      border: 1px solid rgba(52, 211, 153, .2);
    }

    .project-card h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.3rem;
      font-weight: 600;
      color: var(--cream);
      margin-bottom: .5rem;
    }

    .project-card p {
      font-size: .88rem;
      color: var(--text-dim);
      margin-bottom: 1.25rem;
      line-height: 1.65;
    }

    .project-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: .75rem;
    }

    .tech-list {
      display: flex;
      gap: .4rem;
      flex-wrap: wrap;
    }

    .tech-badge {
      font-size: .72rem;
      padding: .2rem .6rem;
      background: rgba(52, 211, 153, .06);
      border: 1px solid rgba(52, 211, 153, .12);
      border-radius: 4px;
      color: var(--text-dim);
    }

    .link-btn {
      display: inline-flex;
      align-items: center;
      gap: .4rem;
      font-size: .8rem;
      font-weight: 500;
      color: var(--work-accent);
      transition: gap .2s;
    }

    .link-btn:hover {
      gap: .65rem;
    }

    /* ===== HOBBIES ===== */
    /* Earthy green — nature/culture atmosphere */
    .hobbies {
      padding: var(--section-pad) clamp(1.5rem, 6vw, 6rem);
      background: linear-gradient(135deg, #1a3a2e 0%, #2d5a4a 100%);
      color: var(--text);
    }

    .hobbies-header {
      max-width: 1200px;
      margin: 0 auto 3rem;
    }

    .hobbies-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      grid-template-rows: auto auto;
      gap: 1.25rem;
    }

    .hobby-card {
      background: rgba(134, 239, 172, .03);
      border: 1px solid rgba(134, 239, 172, .1);
      border-radius: var(--radius);
      overflow: hidden;
      cursor: pointer;
      transition: border-color .3s, transform .3s, box-shadow .3s;
    }

    .hobby-card:hover {
      border-color: rgba(134, 239, 172, .35);
      transform: translateY(-4px);
      box-shadow: 0 8px 32px rgba(134, 239, 172, .1);
    }

    .hobby-card.featured {
      grid-column: span 2;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      min-height: 380px;
    }

    .hobby-thumb {
      aspect-ratio: 5/4;
      overflow: hidden;
      position: relative;
      background: #0a1410;
    }

    .hobby-card.featured .hobby-thumb {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      aspect-ratio: auto;
      z-index: 1;
    }

    .hobby-card.featured .hobby-thumb::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(to top, rgba(8, 15, 11, 0.95) 0%, rgba(8, 15, 11, 0.5) 60%, rgba(8, 15, 11, 0.15) 100%);
      z-index: 2;
    }

    .hobby-card.featured .hobby-body {
      position: relative;
      z-index: 3;
      padding: 3rem 2rem 2rem;
      width: 100%;
    }

    .hobby-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
      transition: transform .5s ease, filter .5s ease;
      filter: brightness(.92) saturate(1.1);
    }

    .hobby-card:hover .hobby-thumb img {
      transform: scale(1.04);
      filter: brightness(1) saturate(1.2);
    }

    .hobby-thumb-placeholder {
      width: 100%;
      height: 100%;
      background: linear-gradient(135deg, #0d1a10 0%, #0a1208 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: rgba(134, 239, 172, .3);
      font-size: 2.5rem;
    }

    .hobby-body {
      padding: 1.25rem;
    }

    .hobby-cat {
      font-size: .7rem;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--hobbies-accent);
      margin-bottom: .5rem;
    }

    .hobby-body h4 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-weight: 600;
      color: var(--cream);
      margin-bottom: .35rem;
    }

    .hobby-body p {
      font-size: .85rem;
      color: var(--text-dim);
      line-height: 1.6;
    }

    /* Wisdom strip */
    .wisdom-strip {
      max-width: 1200px;
      margin: 3rem auto 0;
      background: rgba(134, 239, 172, .04);
      border: 1px solid rgba(134, 239, 172, .12);
      border-radius: var(--radius);
      padding: 2rem 2.5rem;
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .wisdom-icon {
      font-size: 2.5rem;
      color: var(--hobbies-accent);
      opacity: .5;
      flex-shrink: 0;
    }

    .wisdom-text {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.15rem;
      font-style: italic;
      color: var(--text-dim);
      line-height: 1.6;
    }

    .wisdom-text em {
      color: var(--cream);
      font-style: normal;
    }

    /* Heritage symbols */
    .heritage-row {
      max-width: 1200px;
      margin: 2rem auto 0;
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
    }

    .heritage-item {
      background: rgba(134, 239, 172, .03);
      border: 1px solid rgba(134, 239, 172, .1);
      border-radius: var(--radius);
      padding: 1.25rem;
      text-align: center;
      transition: border-color .3s;
    }

    .heritage-item:hover {
      border-color: rgba(134, 239, 172, .25);
    }

    .heritage-icon {
      width: 48px;
      height: 48px;
      border-radius: 50%;
      background: rgba(134, 239, 172, .08);
      border: 1px solid rgba(134, 239, 172, .2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.2rem;
      color: var(--hobbies-accent);
      margin: 0 auto .75rem;
    }

    .heritage-item h4 {
      font-size: .9rem;
      font-weight: 600;
      color: var(--cream);
      margin-bottom: .25rem;
    }

    .heritage-item p {
      font-size: .78rem;
      color: var(--text-dim);
    }

    /* ===== CONTACT ===== */
    /* Deep charcoal with warm rose accent */
    .contact {
      padding: var(--section-pad) clamp(1.5rem, 6vw, 6rem);
      position: relative;
      background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
      color: var(--text);
    }

    .contact::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 30% 50%, rgba(248, 113, 113, .04) 0%, transparent 60%);
      pointer-events: none;
    }

    .contact-inner {
      max-width: 1100px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: clamp(3rem, 6vw, 5rem);
      align-items: start;
    }

    .contact-info .section-label {
      margin-bottom: .75rem;
    }

    .contact-info h2 {
      font-family: 'Cormorant Garamond', serif;
      font-size: clamp(2rem, 4vw, 2.8rem);
      font-weight: 600;
      color: var(--cream);
      margin-bottom: 1rem;
    }

    .contact-info h2 em {
      color: var(--contact-accent);
      font-style: italic;
    }

    .contact-info p {
      font-size: .95rem;
      color: var(--text-dim);
      margin-bottom: 2rem;
      line-height: 1.7;
    }

    .contact-links {
      display: flex;
      flex-direction: column;
      gap: .85rem;
    }

    .contact-link {
      display: flex;
      align-items: center;
      gap: 1rem;
      padding: 1rem 1.25rem;
      background: rgba(248, 113, 113, .04);
      border: 1px solid rgba(248, 113, 113, .1);
      border-radius: var(--radius);
      transition: border-color .25s, box-shadow .25s;
    }

    .contact-link:hover {
      border-color: rgba(248, 113, 113, .3);
      box-shadow: 0 4px 20px rgba(248, 113, 113, .07);
    }

    .cli-icon {
      width: 40px;
      height: 40px;
      border-radius: 8px;
      background: rgba(255, 255, 255, .04);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      color: var(--c, var(--contact-accent));
      flex-shrink: 0;
    }

    .cli-text {
      display: flex;
      flex-direction: column;
    }

    .cli-label {
      font-size: .72rem;
      letter-spacing: .1em;
      text-transform: uppercase;
      color: var(--text-mute);
    }

    .cli-value {
      font-size: .9rem;
      color: var(--text);
      transition: color .2s;
    }

    .contact-link:hover .cli-value {
      color: var(--contact-accent);
    }

    /* Contact form */
    .contact-form {
      background: rgba(248, 113, 113, .03);
      border: 1px solid rgba(248, 113, 113, .1);
      border-radius: var(--radius-lg);
      padding: 2.5rem;
    }

    .cf-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .cf-field {
      margin-bottom: 1.25rem;
    }

    .cf-field label {
      display: block;
      font-size: .78rem;
      font-weight: 500;
      letter-spacing: .08em;
      text-transform: uppercase;
      color: var(--text-dim);
      margin-bottom: .5rem;
    }

    .cf-input-wrap {
      position: relative;
    }

    .cf-input-wrap i {
      position: absolute;
      left: .9rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-mute);
      font-size: .85rem;
      pointer-events: none;
    }

    .cf-input-wrap.textarea-wrap i {
      top: 1rem;
      transform: none;
    }

    .cf-input-wrap input,
    .cf-input-wrap textarea {
      width: 100%;
      padding: .75rem .9rem .75rem 2.5rem;
      background: rgba(255, 255, 255, .04);
      border: 1px solid rgba(248, 113, 113, .12);
      border-radius: var(--radius);
      font-family: 'Outfit', sans-serif;
      font-size: .9rem;
      color: var(--cream);
      outline: none;
      transition: border-color .25s;
      resize: vertical;
    }

    .cf-input-wrap input::placeholder,
    .cf-input-wrap textarea::placeholder {
      color: var(--text-mute);
    }

    .cf-input-wrap input:focus,
    .cf-input-wrap textarea:focus {
      border-color: rgba(248, 113, 113, .4);
      box-shadow: 0 0 0 3px rgba(248, 113, 113, .08);
    }

    .cf-submit {
      width: 100%;
      padding: .9rem 1.5rem;
      background: var(--contact-accent);
      color: #fff;
      border: none;
      border-radius: var(--radius);
      cursor: pointer;
      font-family: 'Outfit', sans-serif;
      font-size: .9rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: .6rem;
      transition: background .25s, transform .2s, box-shadow .25s;
    }

    .cf-submit:hover {
      background: #ef4444;
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(248, 113, 113, .3);
    }

    /* ===== FOOTER ===== */
    footer {
      background: #050504;
      border-top: 1px solid rgba(232, 168, 56, .1);
      padding: 4rem clamp(1.5rem, 6vw, 6rem) 2rem;
    }

    .footer-grid {
      max-width: 1200px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 3rem;
      padding-bottom: 3rem;
      border-bottom: 1px solid var(--border);
    }

    .footer-brand .logo {
      font-size: 1.3rem;
      margin-bottom: .75rem;
      display: block;
    }

    .footer-brand p {
      font-size: .88rem;
      color: var(--text-dim);
      line-height: 1.65;
    }

    .footer-col h4 {
      font-size: .78rem;
      font-weight: 600;
      letter-spacing: .12em;
      text-transform: uppercase;
      color: var(--gold);
      margin-bottom: 1rem;
    }

    .footer-col a,
    .footer-col p {
      display: block;
      font-size: .88rem;
      color: var(--text-dim);
      padding: .25rem 0;
      transition: color .2s;
    }

    .footer-col a:hover {
      color: var(--gold);
    }

    .footer-col p i {
      margin-right: .5rem;
      color: var(--gold);
    }

    .footer-socials {
      display: flex;
      gap: .75rem;
      margin-top: .75rem;
    }

    .footer-socials a {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: .85rem;
      color: var(--text-dim);
      transition: all .25s;
    }

    .footer-socials a:hover {
      border-color: var(--gold);
      color: var(--gold);
    }

    .footer-bottom {
      max-width: 1200px;
      margin: 2rem auto 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: .8rem;
      color: var(--text-mute);
      flex-wrap: wrap;
      gap: .5rem;
    }

    .footer-bottom span {
      color: var(--gold);
    }

    /* ===== SCROLL TOP ===== */
    #scroll-top {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 999;
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--gold);
      color: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1rem;
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s, transform .3s;
    }

    #scroll-top.visible {
      opacity: 1;
      pointer-events: all;
    }

    #scroll-top:hover {
      transform: translateY(-3px);
    }

    /* ===== MODAL ===== */
    .modal {
      position: fixed;
      inset: 0;
      z-index: 2000;
      background: rgba(0, 0, 0, .8);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s;
      padding: 1rem;
    }

    .modal.open {
      opacity: 1;
      pointer-events: all;
    }

    .modal-box {
      background: var(--bg2);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      max-width: 680px;
      width: 100%;
      overflow: hidden;
      transform: scale(.95);
      transition: transform .3s;
    }

    .modal.open .modal-box {
      transform: scale(1);
    }

    .modal-img {
      aspect-ratio: 4/3;
      overflow: hidden;
    }

    .modal-img img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top center;
    }

    .modal-img-placeholder {
      width: 100%;
      height: 100%;
      background: var(--bg3);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-mute);
      font-size: 3rem;
    }

    .modal-body {
      padding: 1.75rem;
    }

    .modal-close {
      float: right;
      background: none;
      border: none;
      color: var(--text-dim);
      font-size: 1.2rem;
      cursor: pointer;
      margin-left: 1rem;
      transition: color .2s;
    }

    .modal-close:hover {
      color: var(--cream);
    }

    .modal-body h3 {
      font-family: 'Cormorant Garamond', serif;
      font-size: 1.5rem;
      font-weight: 600;
      color: var(--cream);
      margin-bottom: .75rem;
    }

    .modal-body p {
      font-size: .92rem;
      color: var(--text-dim);
      line-height: 1.7;
    }

    /* ===== RESPONSIVE ===== */

    /* ── 1024px: Tablet landscape ── */
    @media (max-width: 1024px) {
      .home {
        gap: 2.5rem;
      }

      .hero-img-frame {
        width: min(380px, 92%);
      }

      .about-inner {
        grid-template-columns: 1fr 1.4fr;
        gap: 2.5rem;
      }

      .stats-row {
        grid-template-columns: repeat(2, 1fr);
      }

      .work-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-grid {
        grid-template-columns: 1.2fr 1fr 1fr;
        gap: 2rem;
      }
    }

    /* ── 900px: Tablet portrait ── */
    @media (max-width: 900px) {

      /* Hero — stack vertically, centre everything */
      .home {
        grid-template-columns: 1fr;
        text-align: center;
        padding-top: 7rem;
        padding-bottom: 4rem;
        min-height: auto;
        gap: 3rem;
      }

      .home::after {
        display: none;
      }

      .hero-eyebrow {
        justify-content: center;
      }

      .hero-btns {
        justify-content: center;
      }

      .hero-socials {
        justify-content: center;
      }

      /* Show a smaller hero image on tablet */
      .hero-img-col {
        display: flex;
        order: -1;
        /* image above text */
      }

      .hero-img-frame {
        width: min(300px, 72vw);
      }

      .hero-deco {
        width: 80px;
        height: 80px;
      }

      /* About */
      .about-inner {
        grid-template-columns: 1fr;
      }

      .about-card {
        position: static;
        max-width: 420px;
        margin: 0 auto;
      }

      .stats-row {
        grid-template-columns: repeat(2, 1fr);
      }

      /* Projects */
      .work-grid {
        grid-template-columns: 1fr;
      }

      /* Hobbies */
      .hobbies-grid {
        grid-template-columns: 1fr 1fr;
      }

      .hobby-card.featured {
        grid-column: span 2;
      }

      /* Contact */
      .contact-inner {
        grid-template-columns: 1fr;
      }

      /* Footer */
      .footer-grid {
        grid-template-columns: 1fr;
        gap: 2rem;
      }
    }

    /* ── 860px: Hide desktop nav, show hamburger ── */
    @media (max-width: 860px) {
      .navbar {
        display: none;
      }

      #menu {
        display: flex;
      }
    }

    /* ── 768px: Large phone / small tablet ── */
    @media (max-width: 768px) {
      :root {
        --section-pad: clamp(3.5rem, 8vw, 6rem);
      }

      /* Header */
      header {
        padding: .85rem clamp(1rem, 4vw, 2rem);
      }

      /* Hero */
      .home {
        padding-top: 6rem;
        gap: 2rem;
      }

      .home-content h1 {
        font-size: clamp(2.8rem, 9vw, 4rem);
      }

      .hero-role {
        font-size: .95rem;
      }

      .typing-wrap {
        font-size: .92rem;
      }

      .hero-img-frame {
        width: min(260px, 68vw);
      }

      .hero-btns {
        gap: .75rem;
      }

      .btn-primary,
      .btn-ghost {
        padding: .7rem 1.4rem;
        font-size: .84rem;
      }

      /* About */
      .about-bio {
        font-size: .97rem;
      }

      .stats-row {
        gap: .75rem;
      }

      .stat-num {
        font-size: 1.7rem;
      }

      /* Skills grid — 2 columns */
      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      /* Education */
      .edu-entry {
        grid-template-columns: 48px 1fr;
        gap: 0 1rem;
      }

      .edu-dot {
        width: 38px;
        height: 38px;
        font-size: .78rem;
      }

      .edu-card {
        padding: 1.25rem;
      }

      .edu-card h3 {
        font-size: .98rem;
      }

      .edu-card-top {
        flex-direction: column;
        gap: .5rem;
      }

      /* Projects */
      .work-grid {
        grid-template-columns: 1fr;
      }

      .project-card h3 {
        font-size: 1.15rem;
      }

      /* Hobbies */
      .hobbies-grid {
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
      }

      .hobby-card.featured {
        grid-column: span 2;
      }

      .wisdom-strip {
        padding: 1.5rem;
        gap: 1rem;
      }

      .wisdom-icon {
        font-size: 1.8rem;
      }

      .wisdom-text {
        font-size: 1rem;
      }

      .heritage-row {
        grid-template-columns: repeat(2, 1fr);
      }

      /* Contact */
      .cf-row {
        grid-template-columns: 1fr;
      }

      .contact-form {
        padding: 1.75rem;
      }

      /* Footer */
      .footer-grid {
        gap: 1.75rem;
      }

      .footer-bottom {
        flex-direction: column;
        text-align: center;
        gap: .35rem;
      }

      /* Modal */
      .modal-box {
        max-width: 95vw;
      }

      .modal-body {
        padding: 1.25rem;
      }
    }

    /* ── 640px: Phone landscape / large phone ── */
    @media (max-width: 640px) {

      /* Hobbies — single column */
      .hobbies-grid {
        grid-template-columns: 1fr;
      }

      .hobby-card.featured {
        grid-column: span 1;
        display: block;
        min-height: auto;
      }

      .hobby-card.featured .hobby-thumb {
        position: relative;
        aspect-ratio: 5/4;
      }

      .hobby-card.featured .hobby-thumb::after {
        display: none;
      }

      .hobby-card.featured .hobby-body {
        padding: 1.25rem;
      }

      /* Heritage — 2 cols still fine */
      .heritage-row {
        grid-template-columns: repeat(2, 1fr);
      }

      /* Skills — 2 cols */
      .skills-grid {
        grid-template-columns: repeat(2, 1fr);
      }

      /* About stats — 2 cols */
      .stats-row {
        grid-template-columns: repeat(2, 1fr);
      }

      /* Contact form */
      .cf-row {
        grid-template-columns: 1fr;
      }
    }

    /* ── 480px: Standard phone portrait ── */
    @media (max-width: 480px) {
      :root {
        --section-pad: clamp(3rem, 7vw, 5rem);
      }

      /* Header */
      header {
        padding: .75rem 1rem;
      }

      .logo {
        font-size: 1.25rem;
      }

      .logo-bracket {
        font-size: 1.5rem;
      }

      /* Hero */
      .home {
        padding-top: 5.5rem;
        gap: 1.75rem;
      }

      .home-content h1 {
        font-size: clamp(2.4rem, 10vw, 3.2rem);
      }

      .hero-img-frame {
        width: min(220px, 62vw);
      }

      .hero-deco {
        display: none;
      }

      .hero-btns {
        flex-direction: column;
        align-items: center;
        gap: .65rem;
      }

      .btn-primary,
      .btn-ghost {
        width: 100%;
        max-width: 260px;
        justify-content: center;
      }

      /* About */
      .about-card {
        padding: 1.5rem 1rem;
      }

      .about-img-wrap img,
      .about-img-wrap .img-placeholder {
        width: 160px;
        height: 160px;
      }

      .about-card h3 {
        font-size: 1.25rem;
      }

      .stats-row {
        grid-template-columns: repeat(2, 1fr);
        gap: .6rem;
      }

      .stat-item {
        padding: 1rem .75rem;
      }

      .stat-num {
        font-size: 1.5rem;
      }

      .tags-row {
        gap: .4rem;
      }

      .tag-pill {
        font-size: .72rem;
        padding: .28rem .75rem;
      }

      /* Skills — single column on very small phones */
      .skills-grid {
        grid-template-columns: 1fr;
      }

      /* Education */
      .edu-inner {
        padding: 0;
      }

      .edu-entry {
        grid-template-columns: 40px 1fr;
        gap: 0 .75rem;
      }

      .edu-dot {
        width: 34px;
        height: 34px;
        font-size: .72rem;
      }

      .edu-card {
        padding: 1rem;
      }

      .edu-card h3 {
        font-size: .92rem;
      }

      .edu-desc {
        font-size: .82rem;
      }

      .edu-tags {
        gap: .3rem;
      }

      .edu-tags span {
        font-size: .68rem;
        padding: .2rem .55rem;
      }

      /* Projects */
      .project-body {
        padding: 1.1rem;
      }

      .project-card h3 {
        font-size: 1.05rem;
      }

      .project-card p {
        font-size: .82rem;
      }

      .tech-badge {
        font-size: .66rem;
      }

      /* Hobbies */
      .hobby-body {
        padding: 1rem;
      }

      .hobby-card.featured .hobby-body {
        padding: 1rem;
      }

      .hobby-body h4 {
        font-size: 1rem;
      }

      .wisdom-strip {
        flex-direction: column;
        text-align: center;
        padding: 1.25rem;
      }

      .heritage-row {
        grid-template-columns: 1fr 1fr;
        gap: .75rem;
      }

      .heritage-item {
        padding: 1rem .75rem;
      }

      .heritage-item h4 {
        font-size: .82rem;
      }

      /* Contact */
      .contact-form {
        padding: 1.25rem;
      }

      .cf-input-wrap input,
      .cf-input-wrap textarea {
        font-size: .85rem;
      }

      .cf-submit {
        font-size: .85rem;
        padding: .8rem 1.2rem;
      }

      /* Footer */
      .footer-brand .logo {
        font-size: 1.1rem;
      }

      .footer-col h4 {
        font-size: .72rem;
      }

      .footer-col a,
      .footer-col p {
        font-size: .82rem;
      }

      .footer-bottom {
        font-size: .74rem;
      }

      /* Scroll top */
      #scroll-top {
        width: 38px;
        height: 38px;
        font-size: .88rem;
        bottom: 1.25rem;
        right: 1.25rem;
      }
    }

    /* ── 360px: Very small phones (Galaxy A series etc.) ── */
    @media (max-width: 360px) {
      .home-content h1 {
        font-size: 2.2rem;
      }

      .hero-img-frame {
        width: min(170px, 55vw);
      }

      .about-img-wrap img,
      .about-img-wrap .img-placeholder {
        width: 140px;
        height: 140px;
      }

      .stats-row {
        grid-template-columns: repeat(2, 1fr);
      }

      .heritage-row {
        grid-template-columns: 1fr;
      }

      .skills-grid {
        grid-template-columns: 1fr;
      }
    }

    /* ── Scroll-top keeps gold ── */
    #scroll-top {
      background: var(--gold);
      color: var(--bg);
    }

    /* ===== PER-SECTION ACCENT OVERRIDES ===== */

    /* About — sky-blue */
    .about .section-label {
      color: var(--about-accent);
    }

    .about .section-label::before {
      background: var(--about-accent);
    }

    .about .section-title span {
      color: var(--about-accent);
    }

    .about .stat-item {
      background: rgba(56, 189, 248, .05);
      border: 1px solid rgba(56, 189, 248, .12);
    }

    .about .stat-num {
      color: var(--about-accent);
    }

    .about .tag-pill {
      background: rgba(56, 189, 248, .05);
      border-color: rgba(56, 189, 248, .15);
    }

    .about .tag-pill:hover {
      border-color: var(--about-accent);
      color: var(--about-accent);
    }

    .about .about-role-tag {
      color: var(--about-accent);
      border-color: rgba(56, 189, 248, .3);
    }

    .about .about-chips span i {
      color: var(--about-accent);
    }

    .about .about-bio em {
      color: var(--about-accent);
    }

    /* Skills — violet */
    .skills .section-label {
      color: var(--skills-accent);
    }

    .skills .section-label::before {
      background: var(--skills-accent);
    }

    .skills .section-title span {
      color: var(--skills-accent);
    }

    /* Education — amber */
    .education .section-label {
      color: var(--edu-accent);
    }

    .education .section-label::before {
      background: var(--edu-accent);
    }

    .education .section-title span {
      color: var(--edu-accent);
    }

    /* Projects — emerald */
    .work .section-label {
      color: var(--work-accent);
    }

    .work .section-label::before {
      background: var(--work-accent);
    }

    .work .section-title span {
      color: var(--work-accent);
    }

    /* Hobbies — sage-green */
    .hobbies .section-label {
      color: var(--hobbies-accent);
    }

    .hobbies .section-label::before {
      background: var(--hobbies-accent);
    }

    .hobbies .section-title span {
      color: var(--hobbies-accent);
    }

    /* Contact — rose */
    .contact .section-label {
      color: var(--contact-accent);
    }

    .contact .section-label::before {
      background: var(--contact-accent);
    }

    .contact .contact-info h2 em {
      color: var(--contact-accent);
    }
  </style>
</head>

